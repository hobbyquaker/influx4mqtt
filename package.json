{
  "name": "influx4mqtt",
  "version": "2.0.0",
  "description": "Record MQTT values in InfluxDB. Follows the mqtt-smarthome architecture.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "influx4mqtt": "index.js"
  },
  "preferGlobal": true,
  "files": [
    "index.js",
    "config.js",
    "lib/"
  ],
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "scripts": {
    "start": "node index.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "node --test",
    "deploy": "bash deploy.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/influx4mqtt.git"
  },
  "homepage": "https://github.com/hobbyquaker/influx4mqtt",
  "bugs": {
    "url": "https://github.com/hobbyquaker/influx4mqtt/issues"
  },
  "author": "Sebastian Raff <hobbyquaker@gmail.com> (https://github.com/hobbyquaker)",
  "license": "MIT",
  "keywords": [
    "mqtt",
    "mqtt-smarthome",
    "home-automation",
    "influxdb",
    "influx",
    "grafana",
    "time series",
    "history"
  ],
  "mqttInterfaces": {
    "spec": "2.0",
    "envPrefix": "INFLUX4MQTT",
    "needs": [
      "network"
    ],
    "serviceExtra": []
  },
  "dependencies": {
    "mqtt-interfaces-core": "^0.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "globals": "^16",
    "prettier": "^3"
  }
}
